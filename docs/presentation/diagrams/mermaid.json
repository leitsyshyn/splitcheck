    "fontSize": "22px",
    "background": "transparent",
    "primaryColor": "#fffdf8",
    "primaryBorderColor": "#1d1b16",
    "primaryTextColor": "#1d1b16",
    "lineColor": "#1d1b16",
    "secondaryColor": "#fbe3da",
    "tertiaryColor": "#f6f1e7",
    "clusterBkg": "#f6f1e7",
    "clusterBorder": "#b9ad94",
    "edgeLabelBackground": "#f6f1e7",
    "actorBkg": "#fffdf8",
    "actorBorder": "#1d1b16",
    "actorTextColor": "#1d1b16",
    "signalColor": "#1d1b16",
