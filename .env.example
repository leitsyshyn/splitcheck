# Google Cloud project that holds Firestore, the bucket and Vertex AI
GOOGLE_CLOUD_PROJECT=your-project-id
GCS_BUCKET=your-project-id-receipts
# Gemini on Vertex AI (auth = Application Default Credentials, no key)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=global
# Optional fallback: Gemini Developer API key from AI Studio instead of Vertex AI
# GEMINI_API_KEY=
